# Chefchaouen Delivery App Configuration
# Required environment keys and API endpoints

# Base URL for remote backend sync
BACKEND_API_URL="https://api.chefchaouendelivery.ma"

# Mapbox / OpenStreetMap tile token (optional - app includes embedded Chefchaouen vector tiles)
MAP_TILES_API_KEY="placeholder_map_key"

# Twilio or WhatsApp Business Webhook Secret
WHATSAPP_API_TOKEN="placeholder_wa_token"

# Admin Master Security Key
ADMIN_SETUP_KEY="chaouen_admin_secure_2026"
